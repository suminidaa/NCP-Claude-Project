# NCP Object Storage credentials
# 발급 위치: NCP 콘솔 → 마이페이지 → 인증키 관리
NCP_ACCESS_KEY=your-access-key-here
NCP_SECRET_KEY=your-secret-key-here

NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_REGION=kr-standard
NCP_BUCKET=my-budget-bucket

# NCP CLOVA OCR (Receipt 도메인)
# 발급 위치: NCP 콘솔 → AI·Application Service → CLOVA OCR → Domain 생성 (Type: Receipt) → APIGW URL, Secret Key
OCR_APIGW_URL=https://xxxxxxxxxxx.apigw.ntruss.com/custom/v1/00000/xxxxxxx/document/receipt
OCR_SECRET_KEY=your-ocr-secret-key

# App
APP_HOST=0.0.0.0
APP_PORT=8001
