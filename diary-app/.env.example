# NCP Object Storage credentials
# 발급 위치: NCP 콘솔 → 마이페이지 → 인증키 관리 → "신규 API 인증키 생성"
NCP_ACCESS_KEY=your-access-key-here
NCP_SECRET_KEY=your-secret-key-here

# 리전별 엔드포인트
#  한국:    https://kr.object.ncloudstorage.com  (kr-standard)
#  싱가포르: https://sg.object.ncloudstorage.com  (sg-standard)
#  일본:    https://jp.object.ncloudstorage.com  (jp-standard)
NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_REGION=kr-standard

# NCP 콘솔에서 미리 생성한 버킷 이름
NCP_BUCKET=my-diary-bucket

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
