# NCP (네이버 클라우드 플랫폼) 인증 키
# 발급 위치: NCP 콘솔 → 마이페이지 → 계정 관리 → 인증키 관리
# https://www.ncloud.com/mypage/manage/authkey
#
# ⚠️ 이 파일을 복사해 ".env"로 저장한 뒤 실제 키를 채워주세요.
#     .env 파일은 절대 git에 커밋하면 안 됩니다 (.gitignore에 포함됨).

NCP_ACCESS_KEY=your_access_key_here
NCP_SECRET_KEY=your_secret_key_here

# ─────────────────────────────────────────────────────────────
# (선택) 원격 모드 — claude.ai 웹의 '사용자 지정 커넥터'로 연결할 때만 사용
# 비워 두면 기존처럼 stdio 모드(데스크톱 앱 / VS Code용)로 실행됩니다.
#
# MCP_TRANSPORT=http
# MCP_AUTH_TOKEN=   # 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_HOST=127.0.0.1   # 터널(cloudflared 등) 뒤에 둘 때는 127.0.0.1 유지
# MCP_PORT=8000
#
# claude.ai에 등록할 URL:  https://<공개주소>/<MCP_AUTH_TOKEN>/mcp
# ⚠️ 이 URL 자체가 비밀번호입니다. 남에게 공유하거나 캡처해 올리지 마세요.
